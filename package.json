{
  "name": "dlx-solver-workspace",
  "private": true,
  "description": "Tooling for the DLX Solver: a plain-JS frontend (no build step) and a C++ (Drogon) backend.",
  "scripts": {
    "test:frontend": "node frontend/tests/run-tests.js",
    "test:api": "bash scripts/test-api.sh",
    "test:ui": "bash scripts/test-ui.sh",
    "backend:build": "bash scripts/build-backend.sh",
    "backend:test": "ctest --test-dir backend/build --output-on-failure",
    "start": "bash scripts/run.sh"
  },
  "devDependencies": {
    "jsdom": "^26.0.0"
  },
  "license": "Apache-2.0"
}
