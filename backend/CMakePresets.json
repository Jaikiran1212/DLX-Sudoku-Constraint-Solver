{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon, Homebrew",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_PREFIX_PATH": "/opt/homebrew"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "debug",
      "displayName": "Debug with AddressSanitizer + UBSan",
      "inherits": "default",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "DLX_ENABLE_SANITIZERS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "debug", "configurePreset": "debug" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }
  ]
}
