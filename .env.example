# Copy to .env (cp .env.example .env). scripts/run.sh and the VS Code launch config read it.
# The backend needs no secrets: it has no database, no accounts and calls no third-party APIs.
# Never put credentials in this file's committed copy; .env itself is git-ignored.

# Address to listen on. Keep 127.0.0.1 unless you deliberately want other machines to connect.
DLX_HOST=127.0.0.1
DLX_PORT=8080

# Browser origins allowed to call the API (comma-separated, exact match).
#   - Add "null" if you open the frontend from a file:// URL or run it inside Electron.
#   - "*" allows any origin (not recommended).
#   - An empty value disables cross-origin callers.
DLX_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3000,http://localhost:3000

# Serve the frontend from this folder, so http://127.0.0.1:8080 is the whole app.
# Keep this set to ./frontend when using scripts/run.sh. For an API-only server,
# set it empty and launch backend/build/dlx_server directly (not through scripts/run.sh).
DLX_STATIC_DIR=./frontend

# Solver limits.
# Stop counting solutions after this many (2 is enough to tell unique from multiple).
DLX_MAX_SOLUTIONS=2
# Abort a search after this many tried placements (protects the server from runaway requests).
DLX_MAX_NODES=5000000

# Worker threads (0 = one per CPU core) and log level (trace, debug, info, warn, error).
DLX_THREADS=0
DLX_LOG_LEVEL=info
